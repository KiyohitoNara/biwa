<?xml version="1.0" encoding="utf-8"?>
<!--
  PlayerView preconfigured with a TextureView surface so the video pixels respect
  graphicsLayer transforms applied by the surrounding Compose AndroidView (needed
  for pinch-to-zoom). A bare SurfaceView is composited via a hardware overlay and
  ignores parent transforms.
-->
<androidx.media3.ui.PlayerView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view"
    app:use_controller="false" />
